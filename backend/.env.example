# Copy this file to a new file named ".env" (in the same folder) and fill in real values.
# NEVER commit the real .env file to git -- it's already listed in .gitignore.

MONGO_URI=paste_your_mongodb_atlas_connection_string_here
DB_NAME=sih_capacity_building

JWT_SECRET=paste_a_long_random_string_here
JWT_EXPIRE_MINUTES=1440

GEMINI_API_KEY=paste_your_gemini_api_key_here
GROQ_API_KEY=paste_your_groq_api_key_here
